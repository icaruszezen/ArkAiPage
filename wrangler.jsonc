{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arkai-page",
  "account_id": "550ddb43b7f5c21bf65f5697cb26936d",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "arkai.vip",
      "custom_domain": true
    }
  ]
}
